# Copy this file to `.env` and fill in real values before starting the stack:
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.

# PostgreSQL superuser used by the API, MockSiem and integration tests.
POSTGRES_USER=postgres
# Replace with a strong password. There is no committed default on purpose.
POSTGRES_PASSWORD=change_me
# Application database created on first start.
POSTGRES_DB=pt_test_db
# Separate database for integration tests (created by infra/postgres/init/01-test-db.sql).
POSTGRES_TEST_DB=pt_test_db_tests
